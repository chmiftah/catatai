# ==========================================
# CATATAI ENVIRONMENT CONFIGURATION
# ==========================================

# Database Neon PostgreSQL (Koneksi Serverless)
DATABASE_URL=postgres://neondb_owner:YOUR_PASSWORD@ep-cool-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# DeepSeek AI API Key (Untuk ekstraksi nota & percakapan WA CatatAi)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# Kunci Rahasia Sesi & Enkripsi Database AES-256-GCM
AUTH_SECRET=your-random-auth-secret
ENCRYPTION_KEY=64_karakter_hex_acak_atau_32_karakter_rahasia

